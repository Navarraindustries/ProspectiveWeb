# ── Python ───────────────────────────────────────────────────────────────── #
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/
pip-wheel-metadata/

# ── Virtual environments ──────────────────────────────────────────────────── #
.venv/
venv/
env/
ENV/

# ── Backend runtime data (never commit) ──────────────────────────────────── #
backend/data/
backend/static/sample-meshes/*.vtp
backend/data/jwt_secret.txt
backend/data/prospective.db

# ── Internal dev artifacts ────────────────────────────────────────────────── #
backend/openapi_check.json

# ── Test artifacts ────────────────────────────────────────────────────────── #
.pytest_cache/
*.pytest_cache
htmlcov/
.coverage
coverage.xml

# ── IDE ───────────────────────────────────────────────────────────────────── #
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── OS ────────────────────────────────────────────────────────────────────── #
.DS_Store
Thumbs.db
desktop.ini

# ── Agent skills (tooling vendorizado; se reinstala con skills-lock.json) ── #
.agents/
frontend/.agents/

# ── Frontend build artifacts ──────────────────────────────────────────────── #
frontend/node_modules/
frontend/dist/
frontend/.env.local
frontend/.env.production

# ── Secrets / environment ─────────────────────────────────────────────────── #
.env
.env.*
!.env.example
*.pem
*.key

# ── DICOM / medical data (patient data must never be in git) ──────────────── #
*.dcm
*.DCM
*.dicom
# Muchos DICOM vienen SIN extensión (IM_0001, 1.2.840…), así que las reglas por
# extensión no bastan: se ignoran las carpetas de estudios enteras.
Archivos DICOM/
Archivos DICOM.zip
DICOM/
**/DICOMDIR
# Foto de perfil / CV subidos en el registro (datos personales).
backend/user_files/
# Archivo duradero de estudios: DICOM de pacientes (nombre, cédula, fecha de
# nacimiento en las cabeceras). NUNCA debe entrar al repositorio.
backend/study_files/
# Comprimidos de estudios (pueden contener datos de paciente).
*.zip
# Informes de avance generados en la raíz: sus tablas etiquetan los casos con el
# apellido real del paciente (tal y como vienen las carpetas DICOM), así que son
# datos identificables aunque el PDF hable del proyecto y no de un paciente.
/Informe-*.pdf

# ── Large binary meshes (use Git LFS or external storage) ────────────────── #
*.stl
*.obj
*.vtp
*.vts
*.vtk

# JWT signing key — moved out of the public data/ mount (see auth_service.py)
backend/secrets/

# Mesh-quality probe output (regenerate with the harness; not source)
backend/*_report.json
backend/mesh_quality_report*.json

# Biblioteca global de clips: geometría propia de la institución y plantillas de
# fabricación. Privada, fuera del montaje público data/ (ver clip_library.py).
backend/clip_library/

# Registro de pedidos de clips: lleva nombre de paciente y caso en la copia
# interna, y los talleres con sus datos de contacto. Privado, fuera de data/.
backend/clip_orders/

# Diseños propios de clips NAVARRO™ (fuente CAD del usuario). Los .stl/.obj ya
# caen por extensión, pero los .mtl no: se ignora la carpeta entera para que un
# «git add» accidental no publique geometría propietaria.
NAVARRO*/
