# ── Python ───────────────────────────────────────────────────────────────── #
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/
pip-wheel-metadata/

# ── Virtual environments ──────────────────────────────────────────────────── #
.venv/
venv/
env/
ENV/

# ── Backend runtime data (never commit) ──────────────────────────────────── #
backend/data/
backend/static/sample-meshes/*.vtp
backend/data/jwt_secret.txt
backend/data/prospective.db

# ── Internal dev artifacts ────────────────────────────────────────────────── #
backend/openapi_check.json

# ── Test artifacts ────────────────────────────────────────────────────────── #
.pytest_cache/
*.pytest_cache
htmlcov/
.coverage
coverage.xml

# ── IDE ───────────────────────────────────────────────────────────────────── #
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── OS ────────────────────────────────────────────────────────────────────── #
.DS_Store
Thumbs.db
desktop.ini

# ── Agent skills (tooling vendorizado; se reinstala con skills-lock.json) ── #
.agents/
frontend/.agents/

# ── Frontend build artifacts ──────────────────────────────────────────────── #
frontend/node_modules/
frontend/dist/
frontend/.env.local
frontend/.env.production

# ── Secrets / environment ─────────────────────────────────────────────────── #
.env
.env.*
!.env.example
*.pem
*.key

# ── DICOM / medical data (patient data must never be in git) ──────────────── #
*.dcm
*.DCM
*.dicom
# Muchos DICOM vienen SIN extensión (IM_0001, 1.2.840…), así que las reglas por
# extensión no bastan: se ignoran las carpetas de estudios enteras.
Archivos DICOM/
Archivos DICOM.zip
DICOM/
**/DICOMDIR
# Foto de perfil / CV subidos en el registro (datos personales).
backend/user_files/
# Archivo duradero de estudios: DICOM de pacientes (nombre, cédula, fecha de
# nacimiento en las cabeceras). NUNCA debe entrar al repositorio.
backend/study_files/
# Comprimidos de estudios (pueden contener datos de paciente).
*.zip
# Informes de avance generados en la raíz: sus tablas etiquetan los casos con el
# apellido real del paciente (tal y como vienen las carpetas DICOM), así que son
# datos identificables aunque el PDF hable del proyecto y no de un paciente.
/Informe-*.pdf

# ── Large binary meshes (use Git LFS or external storage) ────────────────── #
*.stl
*.obj
*.vtp
# Excepción: modelos fijos de la interfaz (el maniquí de orientación), versionados.
!frontend/public/models/*.vtp
*.vts
*.vtk

# JWT signing key — moved out of the public data/ mount (see auth_service.py)
backend/secrets/

# Mesh-quality probe output (regenerate with the harness; not source)
backend/*_report.json
backend/mesh_quality_report*.json

# Biblioteca global de clips: geometría propia de la institución y plantillas de
# fabricación. Privada, fuera del montaje público data/ (ver clip_library.py).
backend/clip_library/

# Registro de pedidos de clips: lleva nombre de paciente y caso en la copia
# interna, y los talleres con sus datos de contacto. Privado, fuera de data/.
backend/clip_orders/

# Diseños de clips NAVARRO™. Se versionan por decisión del propietario
# (2026-09-28): sin ellos, las pruebas de selección, multiclip y ensayo de
# colocación fallan en cualquier copia que no sea la del autor, y eso ya pasó
# —un compañero reportó 12 fallos que solo eran la biblioteca ausente.
#
# ESTE REPOSITORIO ES PÚBLICO. Quedan publicados y no se pueden retirar del
# historial. Se subieron sabiéndolo; si algún día deja de convenir, no basta
# con borrarlos: hay que reescribir el historial y rotar el repositorio.
#
# Las reglas *.stl / *.obj de más arriba los taparían, así que se exceptúan.
!NAVARRO*/
!NAVARRO*/**/*.stl
!NAVARRO*/**/*.obj
!NAVARRO*/**/*.mtl

# Caché incremental de tsc: artefacto de compilación, se regenera al construir.
*.tsbuildinfo

# Estudios DICOM de prueba (109 MB): quedan en local
frontend/Estudios/

# Artículos de referencia descargados (derechos de autor): no van al repositorio público
NEUROLOGY*.pdf
*.article.pdf

# El esquema de la API del que salen los tipos del frontend sí se versiona.
!frontend/openapi.json

# Copias de la base de datos: datos de pacientes.
backend/db_backups/
